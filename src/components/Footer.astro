---
import { site, whatsappLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <strong>{site.name}</strong>
      <p>{site.tagline}</p>
    </div>
    <div class="links">
      <a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>
      {
        site.instagram && (
          <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
            Instagram
          </a>
        )
      }
    </div>
  </div>
  <div class="container copy">© {year} {site.name}. Hecho con leche y paciencia.</div>
</footer>

<a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Pedir por WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"
    ></path>
  </svg>
</a>

<style>
  .footer {
    background: var(--green-2);
    color: var(--cream);
    padding: 48px 0 24px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }
  .footer strong {
    font-family: var(--font-serif);
    font-size: 1.3rem;
  }
  .footer p {
    opacity: 0.75;
    margin: 4px 0 0;
  }
  .links {
    display: flex;
    gap: 20px;
  }
  .copy {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid rgb(247 243 234 / 0.15);
  }
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
    transition: transform 0.15s ease;
  }
  .wa-float:hover {
    transform: scale(1.06);
  }
</style>
