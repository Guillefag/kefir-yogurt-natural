---
import { site, whatsappLink } from '../data/site';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">Artesanal · Probiótico · Natural</span>
      <h1>Kefir vivo,<br />hecho en casa para vos.</h1>
      <p class="lead">{site.description}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={whatsappLink()} target="_blank" rel="noopener">
          Pedir por WhatsApp
        </a>
        <a class="btn btn-ghost" href="#productos">Ver productos</a>
      </div>
      <p class="hero-note">{site.deliveryDays} · {site.zone}</p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 320 360">
        <circle cx="160" cy="190" r="150" fill="#efe8d8" />
        <circle cx="70" cy="80" r="14" fill="#9bb89e" opacity="0.6" />
        <circle cx="270" cy="110" r="9" fill="#9bb89e" opacity="0.6" />
        <circle cx="255" cy="300" r="12" fill="#9bb89e" opacity="0.5" />
        <!-- frasco -->
        <rect x="108" y="58" width="104" height="26" rx="6" fill="#3d5a40" />
        <path
          d="M100 92h120v190a30 30 0 0 1-30 30h-60a30 30 0 0 1-30-30z"
          fill="#fffdf8"
          stroke="#3d5a40"
          stroke-width="6"
          stroke-linejoin="round"
        />
        <path d="M106 150h108v130a24 24 0 0 1-24 24h-60a24 24 0 0 1-24-24z" fill="#f7f3ea" />
        <!-- etiqueta -->
        <rect x="122" y="180" width="76" height="60" rx="8" fill="#3d5a40" />
        <text
          x="160"
          y="216"
          text-anchor="middle"
          font-family="Fraunces, Georgia, serif"
          font-size="20"
          font-weight="700"
          fill="#fffdf8">kefir</text
        >
        <!-- gránulos -->
        <circle cx="128" cy="270" r="6" fill="#efe8d8" />
        <circle cx="146" cy="282" r="4" fill="#efe8d8" />
        <circle cx="190" cy="276" r="5" fill="#efe8d8" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(48px, 8vw, 96px) 0;
  }
  .hero-inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 16px;
  }
  .hero-note {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .hero-art svg {
    width: min(360px, 100%);
    margin-inline: auto;
  }
  @media (min-width: 880px) {
    .hero-inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
